rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Published content is read-only from the public client. Content changes must be
    // made in the Firebase console, an Admin SDK workflow, or a protected admin tool.
    match /siteContent/{documentId} {
      allow get: if documentId in ['home', 'contact', 'settings'];
      allow list, create, update, delete: if false;
    }

    // The client query includes active == true. Team records are never editable by visitors.
    match /teamMembers/{memberId} {
      allow get: if resource.data.active == true;
      allow list: if resource.data.active == true;
      allow create, update, delete: if false;
    }

    // A visitor may create a carefully limited inquiry, but can never read it back.
    match /contactSubmissions/{submissionId} {
      allow create: if isValidContactSubmission();
      allow get, list, update, delete: if false;
    }

    function isValidContactSubmission() {
      return request.resource.data.keys().hasOnly([
        'name', 'email', 'organization', 'subject', 'message', 'createdAt', 'status'
      ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.organization is string
        && request.resource.data.organization.size() <= 160
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 1
        && request.resource.data.subject.size() <= 180
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }
  }
}
